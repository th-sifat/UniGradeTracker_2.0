generator client {
  provider      = "prisma-client-js"
  // Required for reliable Prisma Client generation on Vercel / serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String
  university String?
  createdAt  DateTime   @default(now())
  semesters  Semester[]
}

model Semester {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesterName String
  gpa          Float    @default(0.00)
  createdAt    DateTime @default(now())
  courses      Course[]
}

model Course {
  id          Int      @id @default(autoincrement())
  semesterId  Int
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseCode  String?
  courseTitle String
  credit      Float
  grade       String
  gradePoint  Float
}
